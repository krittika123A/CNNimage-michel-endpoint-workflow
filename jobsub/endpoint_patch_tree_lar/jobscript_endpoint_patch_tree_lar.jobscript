#!/bin/bash

# Dedicated copy for CNNimage endpoint-patch-tree LAr-only JustIN production.
# Input: atmospheric reco2.root PFN from JustIN/MetaCat.
# Output: endpoint_patch_tree_<input_reco2_basename>.root from PointIdTrackEndpointPatchTree.fcl.

FCL_FILE=${FCL_FILE:-$INPUT_TAR_DIR_LOCAL/PointIdTrackEndpointPatchTree.fcl}
DUNE_VERSION=${DUNE_VERSION:-v10_20_03d00}
DUNE_QUALIFIER=${DUNE_QUALIFIER:-e26:prof}

if [ -z ${JUSTIN_PROCESSORS} ]; then
 JUSTIN_PROCESSORS=1
fi

echo "[endpoint_patch_tree_lar] Justin processors: ${JUSTIN_PROCESSORS}"
echo "[endpoint_patch_tree_lar] Input is a JustIN-selected atmospheric reco2.root PFN."
echo "[endpoint_patch_tree_lar] Output will be endpoint_patch_tree_<input_reco2_basename>.root."
echo "[endpoint_patch_tree_lar] Running direct endpoint patch-tree analyzer via FCL: ${FCL_FILE}"

export TF_NUM_THREADS=${JUSTIN_PROCESSORS}
export OPENBLAS_NUM_THREADS=${JUSTIN_PROCESSORS}
export JULIA_NUM_THREADS=${JUSTIN_PROCESSORS}
export MKL_NUM_THREADS=${JUSTIN_PROCESSORS}
export NUMEXPR_NUM_THREADS=${JUSTIN_PROCESSORS}
export OMP_NUM_THREADS=${JUSTIN_PROCESSORS}

source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh
source $INPUT_TAR_DIR_LOCAL/setup-grid
setup dunesw "$DUNE_VERSION" -q "$DUNE_QUALIFIER"
mrbslp

export FW_SEARCH_PATH=.:${INPUT_TAR_DIR_LOCAL}:$FW_SEARCH_PATH
export FHICL_FILE_PATH=.:${INPUT_TAR_DIR_LOCAL}:$FHICL_FILE_PATH

if [ "$NUM_EVENTS" != "" ] ; then
 events_option="-n $NUM_EVENTS"
else
 events_option=""
fi

did_pfn_rse=`$JUSTIN_PATH/justin-get-file`

if [ "$did_pfn_rse" = "" ] ; then
  echo "[endpoint_patch_tree_lar] Nothing to process - exit jobscript"
  exit 0
fi

echo "$did_pfn_rse" | cut -f1 -d' ' >>all-input-dids.txt
pfn=`echo $did_pfn_rse | cut -f2 -d' '`
echo "[endpoint_patch_tree_lar] Input PFN = $pfn"
echo "[endpoint_patch_tree_lar] This is the reco2.root input; reco_endpoint_patch_tree.root is the analyzer output."
echo "[endpoint_patch_tree_lar] events_option = ${events_option:-<all events>}"

now=$(date -u +"%Y-%m-%dT_%H%M%SZ")
Ffname=`echo $pfn | awk -F/ '{print $NF}'`
fname=`echo $Ffname | awk -F. '{print $1}'`

(
export LD_PRELOAD=${XROOTD_LIB}/libXrdPosixPreload.so
echo "[endpoint_patch_tree_lar] lar -c $FCL_FILE $events_option $pfn"
lar -c $FCL_FILE $events_option "$pfn" > ${fname}_endpoint_patch_tree_${now}.log 2>&1
)

larExit=$?
echo "[endpoint_patch_tree_lar] lar exit code $larExit"

echo '=== Start last 100 lines of lar log file ==='
tail -100 ${fname}_endpoint_patch_tree_${now}.log
echo '=== End last 100 lines of lar log file ==='

if [ -f reco_endpoint_patch_tree.root ] ; then
  echo "[endpoint_patch_tree_lar] Renaming analyzer output reco_endpoint_patch_tree.root to endpoint_patch_tree_${fname}.root"
  mv reco_endpoint_patch_tree.root endpoint_patch_tree_${fname}.root
else
  echo "[endpoint_patch_tree_lar] ERROR: expected analyzer output reco_endpoint_patch_tree.root was not produced"
  larExit=1
fi

if [ $larExit -eq 0 ] ; then
  echo "$pfn" > justin-processed-pfns.txt
  jobscriptExit=0
else
  jobscriptExit=1
fi

tar zcf `echo "$JUSTIN_JOBSUB_ID.logs.tgz" | sed 's/@/_/g'` *.log all-input-dids.txt justin-processed-pfns.txt 2>/dev/null
exit $jobscriptExit
